---
import "../styles/global.css";

const research = [
  {
    index: "01",
    status: "Funded research · 2025",
    title: "Strategic Openness of the Innovation Portfolio",
    description:
      "How firms decide what to reveal and what to protect across patents, academic publications, and open-source code—and how those choices change with AI.",
    href: "https://mackinstitute.wharton.upenn.edu/2025/strategic-openness-of-the-innovation-portfolio/",
    linkLabel: "Project overview",
  },
  {
    index: "02",
    status: "Work in progress",
    title: "Legacy Systems in the Era of Generative AI",
    description:
      "How accumulated IT systems shape firm value, organizational adaptability, and the adoption of generative AI.",
  },
  {
    index: "03",
    status: "Academy of Management · 2025",
    title: "The Talent Landscape",
    description:
      "With David Hsu and Paul Hamilton. Large-scale evidence on how talent relocates, concentrates, and diffuses as new technologies mature.",
    href: "https://aom2025.eventscribe.net/ajaxcalls/PresentationInfo.asp?PresentationID=1638880",
    linkLabel: "Conference abstract",
  },
];

const currentYear = new Date().getFullYear();
const productionHost = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const socialImage = productionHost
  ? `https://${productionHost}/og.png`
  : "/og.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Zhiwei (Berry) Wang is a doctoral candidate at the Wharton School studying the economics of IT, technology strategy, and generative AI."
    />
    <meta name="theme-color" content="#f4efe5" />
    <meta property="og:title" content="Zhiwei (Berry) Wang" />
    <meta
      property="og:description"
      content="Research on how digital technologies shape firm competition."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Zhiwei (Berry) Wang — Economics of IT, Technology Strategy, Generative AI"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <title>Zhiwei (Berry) Wang — Technology Strategy Researcher</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Zhiwei Berry Wang, home">
        <span>ZW</span>
        <span class="wordmark-name">Zhiwei <i>(Berry)</i> Wang</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#research">Research</a>
        <a href="#cv">CV</a>
        <a href="#teaching">Teaching</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Technology strategy · Economics of IT</p>
          <h1 id="hero-title">
            I study how firms <em>adapt</em> when technology changes.
          </h1>
          <p class="hero-intro">
            I’m Zhiwei (Berry) Wang, a doctoral candidate at the Wharton School.
            My research examines how digital technologies reshape firm
            competition, innovation strategy, and organizational advantage.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#research">Explore research</a>
            <a class="text-link" href="mailto:zwangcj@wharton.upenn.edu"
              >zwangcj@wharton.upenn.edu <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>

        <div class="portrait-wrap">
          <div class="portrait-frame">
            <img
              src="/berry-wang-portrait.jpg"
              alt="Portrait of Zhiwei (Berry) Wang"
              width="1600"
              height="2400"
              fetchpriority="high"
            />
          </div>
          <p class="portrait-caption">
            Doctoral Candidate<br />
            Operations, Information and Decisions<br />
            The Wharton School
          </p>
        </div>

        <div class="hero-marker" aria-hidden="true">
          <span>Research</span>
          <span class="marker-line"></span>
          <span>Philadelphia, PA</span>
        </div>
      </section>

      <section class="statement" aria-label="Research statement">
        <p>
          Digital technologies are widely available. The ability to turn them
          into an advantage is not.
        </p>
      </section>

      <section class="section research-section" id="research" aria-labelledby="research-title">
        <div class="section-heading">
          <p class="section-number">01</p>
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="research-title">Research</h2>
          </div>
          <p class="section-intro">
            I use large-scale archival data and firm-level technology measures
            to understand why organizations differ in their ability to respond
            to technological change.
          </p>
        </div>

        <div class="research-list">
          {
            research.map((project) => (
              <article class="research-item">
                <span class="research-index" aria-hidden="true">{project.index}</span>
                <div class="research-copy">
                  <p class="research-status">{project.status}</p>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>
                {project.href ? (
                  <a
                    class="circle-link"
                    href={project.href}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${project.linkLabel}: ${project.title}`}
                    title={project.linkLabel}
                  >
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="circle-link circle-link-muted" aria-label="Work in progress">
                    <span aria-hidden="true">—</span>
                  </span>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="section profile-section" id="cv" aria-labelledby="profile-title">
        <div class="section-heading compact-heading">
          <p class="section-number">02</p>
          <div>
            <p class="eyebrow">Background</p>
            <h2 id="profile-title">Profile</h2>
          </div>
        </div>

        <div class="profile-grid">
          <div class="profile-lead">
            <p>
              My work sits at the intersection of information systems, strategy,
              and the economics of innovation.
            </p>
            <a class="button button-outline" href="mailto:zwangcj@wharton.upenn.edu?subject=CV%20request"
              >Request CV <span aria-hidden="true">↗</span></a
            >
            <p class="availability">
              A downloadable CV will be added when the current PDF is supplied.
            </p>
          </div>

          <dl class="credentials">
            <div>
              <dt>Current</dt>
              <dd>
                Doctoral Candidate<br />
                Operations, Information and Decisions<br />
                The Wharton School
              </dd>
            </div>
            <div>
              <dt>Education</dt>
              <dd>
                BSc, Computer Science<br />
                BBA, Business Management<br />
                Hong Kong University of Science and Technology
              </dd>
            </div>
            <div>
              <dt>Interests</dt>
              <dd>
                Economics of IT<br />
                Technology Strategy<br />
                Generative AI
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section teaching-section" id="teaching" aria-labelledby="teaching-title">
        <div class="section-heading compact-heading">
          <p class="section-number">03</p>
          <div>
            <p class="eyebrow">In the classroom</p>
            <h2 id="teaching-title">Teaching</h2>
          </div>
        </div>

        <div class="teaching-panel">
          <p class="teaching-lead">
            My teaching interests connect technology strategy with the
            practical choices managers face as AI and digital systems evolve.
          </p>
          <div class="topic-list" aria-label="Teaching interests">
            <span>Technology strategy</span>
            <span>Economics of digital markets</span>
            <span>AI in business</span>
          </div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <p class="section-number">04</p>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Let’s talk about technology, firms, and what comes next.</h2>
        <a class="contact-email" href="mailto:zwangcj@wharton.upenn.edu">
          zwangcj@wharton.upenn.edu <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-links">
          <a
            href="https://oid.wharton.upenn.edu/profile/zwangcj/"
            target="_blank"
            rel="noreferrer">Wharton profile</a
          >
          <a
            href="https://www.linkedin.com/in/zhiwei-berry-wang-2b529a13a"
            target="_blank"
            rel="noreferrer">LinkedIn</a
          >
        </div>
      </section>
    </main>

    <footer>
      <p>© {currentYear} Zhiwei (Berry) Wang</p>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
