{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "hugo --gc --minify --destination dist --baseURL \"https://berrywang.com\"",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/research",
      "destination": "https://berrywang.com/#research",
      "permanent": true
    },
    {
      "source": "/research/",
      "destination": "https://berrywang.com/#research",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://berrywang.com/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "https://berrywang.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.berrywang.com"
        }
      ],
      "destination": "https://berrywang.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "personal-website-rose-phi-98.vercel.app"
        }
      ],
      "destination": "https://berrywang.com/$1",
      "permanent": true
    }
  ]
}
